{
  "name": "cesizen",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "check": "npm run lint && npm run type-check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx lib/db/seed.ts",
    "db:migrate-colors": "tsx lib/db/migrate-colors.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "db:test-setup": "bun run db:migrate && bun run db:seed",
    "db:reset": "psql $DATABASE_URL -f reset-db.sql",
    "db:check-admin": "tsx scripts/check-admin.ts",
    "db:reset-admin": "tsx scripts/reset-admin.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "start:prod": "drizzle-kit migrate && next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-color": "^3.30.0",
    "@tiptap/extension-image": "^3.30.0",
    "@tiptap/extension-link": "^3.30.0",
    "@tiptap/extension-text-align": "^3.30.0",
    "@tiptap/extension-text-style": "^3.30.0",
    "@tiptap/extension-underline": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.5",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.5",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.4",
    "jsdom": "^30.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.26",
    "esbuild": "0.28.2",
    "sharp": "0.35.0",
    "form-data": "4.0.6",
    "@babel/core": "8.0.1",
    "nanoid": "6.0.1",
    "brace-expansion": "1.1.18"
  }
}

# Application
NODE_ENV=development
PRE_PROD=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cesizen
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-exactly-64-hexadecimal-characters

# Initial administrator
ADMIN_NOM=Admin
ADMIN_PRENOM=CESIZen
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional public services
NEXT_PUBLIC_FIDER_URL=

# Sentry runtime configuration
# Keep empty locally: collection is disabled outside staging and production.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_ENVIRONMENT=

# Sentry build configuration (Dokploy build secrets/variables only)
SENTRY_ORG=cesizen-nx
SENTRY_PROJECT=javascript-nextjs
SENTRY_UPLOAD_SOURCE_MAPS=false
# SENTRY_AUTH_TOKEN must never be committed.
SENTRY_AUTH_TOKEN=
